  "forbidden_feature_names": [
    "final_finish",
    "target_win",
    "target_top3",
    "final_win_odds",
    "final_popularity",
    "win_payout_yen_per_100",
    "place_payout_yen_per_100"
  ],
  "forbidden_source_kinds": [
    "JVD_FINAL_PARSED",
    "POST_RACE_FINAL_STATE",
    "RESULT_FILE"
  ],
  "source_time_basis_values": [
    "OFFICIAL_ANNOUNCEMENT",
    "LOCAL_ACQUISITION"
  ],
  "rules": [
    "Both feature_source_time_jst and source_capture_time_jst must be offset-aware and <= prediction_snapshot_time_jst.",
    "For OFFICIAL_ANNOUNCEMENT, feature_source_time_jst <= source_capture_time_jst.",
    "For LOCAL_ACQUISITION, feature_source_time_jst must equal source_capture_time_jst.",
    "Each feature name is fail-closed allowlisted to approved source kinds.",
    "Every referenced source_file_sha256 must be backed by a source manifest whose actual file bytes recompute to the same SHA-256.",
    "Each race_id/horse_no/snapshot_role/feature_name resolves to exactly one frozen value.",
    "Blank race_id, horse_no, feature_name, feature_value, source_row_id are violations.",
    "Post-race/outcome fields are forbidden regardless of timestamp."
  ],
  "pass_condition": "Zero violations, verified input SHA when supplied, and all referenced source hashes independently recomputed from the source manifest.",
  "validation_oos_opened": false
}